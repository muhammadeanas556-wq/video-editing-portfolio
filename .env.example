# Set these in Netlify Project configuration > Environment variables.
# Do NOT put real secrets in index.html or admin.html.
ADMIN_EMAIL=your-admin-email@gmail.com
ADMIN_PASSWORD=choose-a-strong-password
SESSION_SECRET=generate-a-long-random-secret

# Optional: enables direct video/poster uploads from the admin panel.
# Create an UNSIGNED upload preset in Cloudinary.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset
